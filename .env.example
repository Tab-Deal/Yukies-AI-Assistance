# YUKIES AI Shopping Companion & Support Assistant – Environment Configuration

# 1. Google Gemini Cloud API (GDPR / Vertex AI Express / Google GenAI SDK)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GCP_PROJECT_ID=yukies-ai-assistance
GCP_LOCATION=europe-west3

# 2. Database (SQLite Async for Local Sandbox / PostgreSQL + pgvector for Production)
DATABASE_URL=sqlite+aiosqlite:///./yukies_assistant.db
DATA_RETENTION_DAYS=180

# 3. Store Configuration (YUKIES – Shopify Dawn 7.0)
STORE_NAME=YUKIES
STORE_DOMAIN=yukies.at
SHOPIFY_MODE=sandbox
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-10

# 4. Human Handoff & Support Notification (Silvia Ragucci & Barbara Bischof-Fünfrock)
SUPPORT_EMAIL_PRIMARY=office@bacciorganics.com
SUPPORT_EMAIL_SECONDARY=office@yukies.at
SUPPORT_AGENTS=Silvia Ragucci,Barbara Bischof-Fünfrock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# 5. Admin Panel Security
ADMIN_API_KEY=yukies-admin-secret-2026
